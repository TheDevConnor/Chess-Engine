const parse_move_str -> fn (mv: *board::Move, move_str: *byte, offset: i64) i64 {
  let idx: i64 = offset;
  
  // Skip whitespace
  loop (move_str[idx] == ' ') : (++idx) {}
  
  if (move_str[idx] == cast<byte>(0)) { return -1; }
  
  let from_col: byte = move_str[idx];
  let from_row: byte = move_str[idx + 1];
  let to_col: byte = move_str[idx + 2];
  let to_row: byte = move_str[idx + 3];
  
  mv.from_col = cast<i64>(from_col) - cast<i64>('a');
  mv.from_row = 7 - (cast<i64>(from_row) - cast<i64>('1'));
  mv.to_col = cast<i64>(to_col) - cast<i64>('a');
  mv.to_row = 7 - (cast<i64>(to_row) - cast<i64>('1'));
  
  return idx + 4; 
}

const matches_opening_line -> fn (moves: **byte, move_count: i64, line: *OpeningLine) i64 {
  if (move_count >= line.move_count) { return 0; }
  
  let mv: board::Move;
  let offset: i64 = 0;
  
  loop [i: i64 = 0](i < move_count) : (++i) {
    offset = parse_move_str(&mv, line.moves, offset);
    if (offset == -1) { return 0; }
    
    let actual_from_col: i64 = cast<i64>(moves[i][0]) - cast<i64>('a');
    let actual_from_row: i64 = 7 - (cast<i64>(moves[i][1]) - cast<i64>('1'));
    let actual_to_col: i64 = cast<i64>(moves[i][2]) - cast<i64>('a');
    let actual_to_row: i64 = 7 - (cast<i64>(moves[i][3]) - cast<i64>('1'));
    
    if (mv.from_col != actual_from_col || mv.from_row != actual_from_row ||
        mv.to_col != actual_to_col || mv.to_row != actual_to_row) {
      return 0;
    }
    
    if (line.moves[offset] == ' ') { offset = offset + 1; }
  }
  
  return 1; 
}

pub const get_book_move -> fn (moves: **byte, move_count: i64, result_move: *board::Move) i64 {
  loop [i: i64 = 0](i < OpeningBookSize) : (++i) {
    if (matches_opening_line(moves, move_count, &OPENING_BOOK[i]) == 1) {
      let offset: i64 = 0;
      let mv: board::Move;
      
      loop [j: i64 = 0](j <= move_count) : (++j) {
        let move_str: *byte = OPENING_BOOK[i].moves;
        offset = parse_move_str(&mv, move_str, offset);
        if (offset == -1) { return 0; }
        if (move_str[offset] == ' ') { offset = offset + 1; }
      }
      
      result_move.from_col = mv.from_col;
      result_move.from_row = mv.from_row;
      result_move.to_col = mv.to_col;
      result_move.to_row = mv.to_row;
      
      return 1; 
    }
  }
  
  return 0; 
}

pub const get_opening_name -> fn (moves: **byte, move_count: i64) *byte {
  let best_match_name: *byte = "Unknown Opening";
  let best_match_length: i64 = 0;
  
  loop [i: i64 = 0](i < OpeningBookSize) : (++i) {
    if (matches_opening_line(moves, move_count, &OPENING_BOOK[i]) == 1) {
      if (OPENING_BOOK[i].move_count > best_match_length) {
        best_match_length = OPENING_BOOK[i].move_count;
        best_match_name = OPENING_BOOK[i].name;
      }
    }
  }
  
  return best_match_name;
}

pub const is_in_book -> fn (moves: **byte, move_count: i64) i64 {
  loop [i: i64 = 0](i < OpeningBookSize) : (++i) {
    if (matches_opening_line(moves, move_count, &OPENING_BOOK[i]) == 1) {
      return 1;
    }
  }
  return 0;
}

